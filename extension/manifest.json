{
  "manifest_version": 3,
  "name": "stdout",
  "version": "0.1.0",
  "description": "A simple Chrome extension for console-logging *other* Chrome extensions",
  "author": "John Dunning",
  "key": "",
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "64": "img/icon-64.png",
    "128": "img/icon-128.png"
  },
  "action": {
    "default_title": "stdout: click to let coding agents read the logs"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "offline_enabled": true
}
