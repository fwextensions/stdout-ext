{
  "name": "stdout-ext",
  "version": "0.1.0",
  "description": "A simple Chrome extension for console-logging *other* Chrome extensions",
  "keywords": [
    "chrome",
    "extension",
    "service worker",
    "manifest v3",
    "console",
    "mcp"
  ],
  "author": "John Dunning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwextensions/stdout-ext.git"
  },
  "bugs": {
    "url": "https://github.com/fwextensions/stdout-ext/issues"
  },
  "homepage": "https://github.com/fwextensions/stdout-ext#readme",
  "type": "module",
  "files": [
    "lib/stdout.js",
    "types/stdout.d.ts",
    "extension",
    "mcp"
  ],
  "exports": {
    ".": {
      "import": "./lib/stdout.js",
      "types": "./types/stdout.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "stdout-ext-mcp": "mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
